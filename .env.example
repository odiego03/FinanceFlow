PGHOST=ep-xxxx.neon.tech
PGPORT=5432
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=troque-pela-senha-real
# minimo de 32 caracteres (exigencia do algoritmo de assinatura do token)
JWT_SECRET=troque-por-uma-chave-secreta-com-pelo-menos-32-caracteres

VITE_API_URL=http://localhost:8080
# Origens que podem chamar a API (separadas por vírgula); no docker-compose o frontend fica em localhost:3000
CORS_ORIGENS=http://localhost:3000

# SMTP do "esqueci minha senha". Gmail: smtp.gmail.com, porta 587, MAIL_SENHA = senha de app de 16 letras
# (Conta Google > Segurança > Verificação em duas etapas > Senhas de app). Vazio = o código só aparece no log do backend
MAIL_HOST=smtp.gmail.com
MAIL_PORTA=587
MAIL_USUARIO=financeflow.projeto@gmail.com
MAIL_SENHA=troque-pela-senha-de-app
# Opcional: endereço que aparece como remetente (padrão = MAIL_USUARIO)
MAIL_REMETENTE=
